# Os provedores padrão abaixo funcionam sem chave e sem cobrança.
VITE_ROUTING_PROVIDER=auto
VITE_GEOCODING_PROVIDER=auto

# Provedores opcionais com plano gratuito. Deixe vazios para usar somente
# OpenStreetMap, Nominatim, Photon, OSRM, Valhalla e o cálculo local.
VITE_OPENROUTESERVICE_API_KEY=
VITE_GRAPHHOPPER_API_KEY=
VITE_GEOAPIFY_API_KEY=
VITE_LOCATIONIQ_API_KEY=

# Firebase Web SDK (valores públicos do aplicativo Web; não use credenciais Admin)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GROQ_API_KEY é segredo de servidor. Configure-a somente no ambiente do Worker.
# Nunca crie uma variável VITE_GROQ_API_KEY.
GROQ_API_KEY=
