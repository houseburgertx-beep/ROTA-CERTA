# Os provedores padrão abaixo funcionam sem chave e sem cobrança.
VITE_ROUTING_PROVIDER=auto
VITE_GEOCODING_PROVIDER=auto

# Provedores opcionais com plano gratuito. Deixe vazios para usar somente
# OpenStreetMap, Nominatim, Photon, OSRM, Valhalla e o cálculo local.
VITE_OPENROUTESERVICE_API_KEY=
VITE_GRAPHHOPPER_API_KEY=
VITE_GEOAPIFY_API_KEY=
VITE_LOCATIONIQ_API_KEY=
